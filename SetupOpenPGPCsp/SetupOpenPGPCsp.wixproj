<Project Sdk="WixToolset.Sdk/5.0.1">
  <PropertyGroup>
    <OutputName>SetupOpenPGPCsp</OutputName>
    <OutputType>Package</OutputType>
    <Platforms>x86;x64;ARM64</Platforms>
    <Platform Condition=" '$(Platform)' == '' or '$(Platform)' == 'AnyCPU' ">x64</Platform>
    <RootDir>$(MSBuildThisFileDirectory)..</RootDir>
    <OutputPath>$(RootDir)\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <DefineConstants>$(DefineConstants);RootDir=$(RootDir);Plat=$(Platform);Config=$(Configuration)</DefineConstants>
    <SuppressPdbOutput>true</SuppressPdbOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.1" />
  </ItemGroup>
</Project>
